@@ -0,0 +1,550 @@
+#!/usr/bin/env bun
+// ============================================================================
+// office-snapshot — headless bake of מפקדת הצי (FleetHQ office)
+// ----------------------------------------------------------------------------
+// NO parallel fake office here: this tool imports the REAL foreman engine
+// (mini-services/agent-hq/src/office.ts — the same Office class index.ts serves
+// over socket.io) and runs its OWN scripted demo scenario (src/sim.ts) against
+// the bundled demo-data/ books, exactly like `AGENT_HQ_MODE=sim` does live.
+//
+// What it emits (into status/):
+//   office.json — machine-readable office state; every value is MEASURED from
+//                 the engine snapshot, the real demo books on disk, or the run
+//                 itself. Zero invented numbers; failures exit non-zero.
+//   office.html — self-contained RTL dark page (Hebrew + English), zero
+//                 external assets, zero JS, loud DEMO · SIMULATION watermark.
+//                 Palette + state/task naming reuse the UI's own law
+//                 (globals.css night palette, src/components/hq/tokens.ts,
+//                 src/components/agent-hq/i18n.ts).
+//
+// Honesty laws kept here:
+//   · the office never calls an LLM (sim scenario is scripted — llmUsed:false)
+//   · demo-data is copied byte-for-byte to a runtime temp dir (the engine
+//     writes its durable journal/task state next to its data dir; the copy
+//     keeps the repo tree clean and the provenance explicit)
+//   · crew "peak" frame selection rule is recorded in the JSON itself
+//   · any engine failure or scenario timeout = no files, exit 1
+// ============================================================================
+
+import { cpSync, existsSync, mkdirSync, mkdtempSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+function fail(msg) {
+  console.error(`[office-snapshot] FAIL: ${msg}`);
+  if (typeof RUNTIME_DATA === 'string') {
+    try { rmSync(RUNTIME_DATA, { recursive: true, force: true }); } catch { /* best effort */ }
+  }
+  process.exit(1);
+}
+
+const TOOL_DIR = fileURLToPath(new URL('.', import.meta.url));
+const REPO_ROOT = resolve(TOOL_DIR, '..');
+const DEMO_DATA = join(REPO_ROOT, 'mini-services', 'agent-hq', 'demo-data');
+const OUT_DIR = join(REPO_ROOT, 'status');
+
+const SCENARIO_TIMEOUT_MS = 120_000;
+const PEAK_POLL_MS = 350;
+const DECISION_ANSWER_DELAY_MS = 900;
+
+// ---- the office's own vocabulary (mirrors src/components/agent-hq/i18n.ts) --
+const STATE_HE = {
+  idle: 'פנוי', thinking: 'חושב', reading: 'קורא ספר', checking: 'מצליב נתונים',
+  writing: 'כותב דוח', walking: 'הולך', waiting_user: 'ממתין להכרעה אוטונומית',
+  blocked: 'חסום', done: 'סיים', error: 'תקלה',
+};
+const STATE_EN = {
+  idle: 'Idle', thinking: 'Thinking', reading: 'Reading a book', checking: 'Cross-checking',
+  writing: 'Writing a report', walking: 'Walking', waiting_user: 'Awaiting autonomous resolution',
+  blocked: 'Blocked', done: 'Done', error: 'Error',
+};
+const TASK_HE = {
+  todo: 'מתוכנן', doing: 'בעבודה', review: 'לביקורת', done: 'הושלם',
+  blocked: 'חסום', cancelled: 'בוטל',
+};
+const TASK_EN = {
+  todo: 'Planned', doing: 'In work', review: 'In review', done: 'Done',
+  blocked: 'Blocked', cancelled: 'Cancelled',
+};
+const STATION_HE = { desk: 'שולחן עבודה', wall: 'לוח המשימות', podium: 'שלט ההחלטות', library: 'הספרייה', coffee: 'בר הקפה', offstage: 'מחוץ לחדר' };
+const STATION_EN = { desk: 'Desk', wall: 'Task wall', podium: 'Podium', library: 'Library', coffee: 'Coffee bar', offstage: 'Offstage' };
+
+// semantic law — src/components/hq/tokens.ts (AGENT_SEMANTIC / TASK_SEMANTIC)
+const STATE_SEMANTIC = {
+  idle: 'neutral', thinking: 'working', reading: 'working', checking: 'working', writing: 'working',
+  walking: 'neutral', waiting_user: 'attention', blocked: 'danger', done: 'ok', error: 'danger',
+};
+const TASK_SEMANTIC = {
+  todo: 'neutral', doing: 'working', review: 'attention', done: 'ok', blocked: 'danger', cancelled: 'neutral',
+};
+
+// night palette — src/app/globals.css `.dark` block (the UI's own colors)
+const SEM = {
+  working: '#d9a441', ok: '#46c98a', attention: '#e0b34d', danger: '#e5615e', neutral: '#8a8a95', info: '#9a8ec8',
+};
+const P = {
+  bg: '#0b0b0e', surface: '#131318', surface2: '#1a1a21', surface3: '#22222b',
+  line: 'rgba(255,255,255,0.08)', lineStrong: 'rgba(255,255,255,0.14)',
+  ink: '#e6e6ea', ink2: '#a1a1ab', ink3: '#6b6b76', accent: '#e05fd0', accentDim: 'rgba(224,95,208,0.13)',
+};
+
+const esc = (s) => String(s ?? '')
+  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+  .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+
+// ============================================================================
+// 1) environment + engine import (env MUST be set before office.ts evaluates:
+//    books.ts freezes DATA_DIR at module load)
+// ============================================================================
+let RUNTIME_DATA = null;
+if (!existsSync(DEMO_DATA)) fail(`demo-data missing: ${DEMO_DATA}`);
+RUNTIME_DATA = mkdtempSync(join(tmpdir(), 'fleet-hq-office-bake-'));
+cpSync(DEMO_DATA, RUNTIME_DATA, { recursive: true });
+for (const must of ['status.json', 'mirror.json', 'agents/dex-book.json', 'agents/claims-audit.json', 'agents/fleet-indicators.json']) {
+  if (!existsSync(join(RUNTIME_DATA, must))) fail(`demo-data copy incomplete (missing ${must}) — refusing to bake`);
+}
+
+process.env.AGENT_HQ_MODE = 'sim';
+process.env.AGENT_HQ_DATA_DIR = RUNTIME_DATA;
+delete process.env.AGENT_HQ_FLEET_DIR; // demo law: no receipts/ mirror writes
+
+const bakeStart = Date.now();
+const { Office } = await import(pathToFileURL(join(REPO_ROOT, 'mini-services', 'agent-hq', 'src', 'office.ts')).href);
+
+// ============================================================================
+// 2) run the office's own sim scenario headlessly (no boot(): no floor lock,
+//    no git wire spawn, no LLM probing — status mirrors the engine's own sim
+//    boot branch from office.ts#boot, word for word)
+// ============================================================================
+const decisionsSeen = [];
+const answersGiven = [];
+let closingFeedSeen = false;
+
+const office = new Office((event, payload) => {
+  if (event === 'decision' && payload && payload.status === 'open' && !decisionsSeen.some((d) => d.id === payload.id)) {
+    decisionsSeen.push({ id: payload.id, question: payload.question, options: payload.options ?? [], agentId: payload.agentId, createdAt: payload.createdAt });
+    // the scenario itself defines a default answer after 45s (sim.ts); the bake
+    // resolves it faster via the same autonomous-operator policy path.
+    setTimeout(() => {
+      const option = (payload.options && payload.options[0]) || 'לאשר פרסום';
+      const ok = office.answerDecision(payload.id, option, 'החלטת מפעיל אוטונומי באפייה — מדיניות: הנתיב הבטוח');
+      if (ok) answersGiven.push({ id: payload.id, option });
+    }, DECISION_ANSWER_DELAY_MS);
+  }
+  if (event === 'feed' && payload && typeof payload.text === 'string' && payload.text.includes('התרחיש המדומה הסתיים')) {
+    closingFeedSeen = true;
+  }
+});
+
+office.status = {
+  backend: 'sim',
+  llmProvider: 'none',
+  message: {
+    he: 'מצב הדגמה — צוות מדומה (אפייה מתוזמנת, ללא מפתח מודל)',
+    en: 'Demo mode — simulated crew (scheduled bake, no LLM key)',
+  },
+  startedAt: bakeStart,
+  opsDone: 0,
+};
+office.feedPush('system', 'אפיית תמונת-מצב מתוזמנת (tools/office-snapshot.mjs) — תרחיש הדגמה של המשרד עצמו');
+
+const GOAL_TEXT = 'תרחיש הדגמה מתוזמן — סיור משרד ואפיית תמונת-מצב ציבורית';
+const submitted = office.submitGoal(GOAL_TEXT);
+if (!submitted.ok) fail(`engine refused the bake goal: ${submitted.error}`);
+
+// peak-frame selection (the rule is recorded in the JSON — nothing hidden)
+const peakScore = (snap) => {
+  const nonIdle = snap.agents.filter((a) => a.state !== 'idle').length;
+  const distinct = new Set(snap.tasks.map((t) => t.status)).size;
+  const open = snap.tasks.filter((t) => t.status === 'todo' || t.status === 'doing' || t.status === 'review').length;
+  return nonIdle * 10 + open * 3 + distinct * 5;
+};
+let peak = { score: -1, snap: null, at: 0 };
+
+const t0 = Date.now();
+while (Date.now() - t0 < SCENARIO_TIMEOUT_MS) {
+  const snap = office.snapshot();
+  const score = peakScore(snap);
+  if (score > peak.score) peak = { score, snap, at: Date.now() };
+  if (office.goal?.status === 'done' && closingFeedSeen) break;
+  await new Promise((r) => setTimeout(r, PEAK_POLL_MS));
+}
+if (!(office.goal?.status === 'done' && closingFeedSeen)) {
+  fail(`sim scenario did not complete within ${SCENARIO_TIMEOUT_MS}ms (goal=${office.goal?.status ?? 'none'}, closing feed seen=${closingFeedSeen})`);
+}
+await new Promise((r) => setTimeout(r, 600)); // let the engine settle its final idle states
+
+const finalSnap = office.snapshot();
+const bakeDurationMs = Date.now() - bakeStart;
+
+// ============================================================================
+// 3) measured office state → status/office.json
+// ============================================================================
+const crewOf = (id) => finalSnap.crew.find((c) => c.id === id) ?? peak.snap?.crew.find((c) => c.id === id);
+const agentOf = (snap, id) => snap.agents.find((a) => a.id === id);
+
+const crew = finalSnap.crew.map((c) => {
+  const a = agentOf(peak.snap, c.id) ?? agentOf(finalSnap, c.id);
+  return {
+    id: c.id,
+    name: c.name,            // {he,en} — from the engine's own cast (src/cast.ts)
+    role: c.role,            // 'lead' | 'worker'
+    title: c.title,          // {he,en}
+    color: c.color,
+    specialty: c.specialty,  // {he,en}
+    status: a?.state ?? 'idle',   // measured agent state at the scenario peak
+    statusHe: STATE_HE[a?.state ?? 'idle'] ?? a?.state ?? 'idle',
+    activity: a?.activity ?? '',
+    station: a?.station ?? (c.role === 'lead' ? 'wall' : 'desk'),
+    stationHe: STATION_HE[a?.station ?? 'desk'] ?? '—',
+    capturedAt: new Date(peak.at).toISOString(),
+  };
+});
+
+const wallCounts = (snap) => {
+  const out = { planned: 0, inWork: 0, inReview: 0, done: 0, blocked: 0, cancelled: 0, total: snap.tasks.length };
+  for (const t of snap.tasks) {
+    if (t.status === 'todo') out.planned++;
+    else if (t.status === 'doing') out.inWork++;
+    else if (t.status === 'review') out.inReview++;
+    else if (t.status === 'done') out.done++;
+    else if (t.status === 'blocked') out.blocked++;
+    else if (t.status === 'cancelled') out.cancelled++;
+  }
+  return out;
+};
+
+const tasks = finalSnap.tasks.map((t) => {
+  const c = t.assignee ? crewOf(t.assignee) : undefined;
+  return {
+    id: t.id,
+    title: t.title,
+    status: t.status,
+    statusHe: TASK_HE[t.status] ?? t.status,
+    assignee: t.assignee ?? null,
+    assigneeName: c?.name ?? null,
+    summary: t.summary ?? null,
+    durationMs: t.durationMs ?? null,
+  };
+});
+
+const podium = decisionsSeen.map((d) => {
+  const after = finalSnap.decisions.find((x) => x.id === d.id);
+  const c = crewOf(d.agentId);
+  return {
+    id: d.id,
+    agent: d.agentId,
+    agentName: c?.name ?? null,
+    question: after?.question ?? d.question,
+    options: d.options,
+    status: after?.status ?? 'open',
+    answer: after?.answer ?? null,
+    taskId: after?.taskId ?? null,
+  };
+});
+
+const library = finalSnap.reports.map((r) => ({
+  id: r.id,
+  title: r.title,
+  body: r.body,
+  author: r.author,
+  authorName: crewOf(r.author)?.name ?? null,
+  ts: r.ts,
+}));
+
+const books = finalSnap.books.map((b) => ({
+  id: b.id,
+  title: b.title,
+  category: b.category,
+  bytes: b.bytes,
+  ok: b.ok ?? null,
+  verdict: b.verdict ?? null,
+  owner: b.owner ?? null,
+  heartbeat: b.heartbeat ?? null,
+  ageHours: b.ageHours === undefined ? null : Number(b.ageHours.toFixed(2)),
+}));
+
+const feed = finalSnap.feed.slice(-24).map((f) => ({ ts: f.ts, kind: f.kind, text: f.text, agentId: f.agentId ?? null }));
+
+const officeJson = {
+  v: 1,
+  generatedAt: new Date().toISOString(),
+  generator: 'tools/office-snapshot.mjs',
+  mode: 'sim',
+  watermark: 'DEMO · SIMULATION',
+  watermarkHe: 'דמו · סימולציה',
+  source: 'mini-services/agent-hq/demo-data',
+  provenance: {
+    engine: 'mini-services/agent-hq/src/office.ts (Office — the real foreman engine, sim scenario from src/sim.ts)',
+    books: `${DEMO_DATA} (synthetic demo books, copied byte-for-byte to a runtime temp dir; the engine's durable journal stays in the temp dir)`,
+    namingAndColors: 'src/components/agent-hq/i18n.ts + src/components/hq/tokens.ts + src/app/globals.css night palette',
+    runtimeDataDir: 'os-temp-copy',
+    llmUsed: false,
+    bakeDurationMs,
+    peakRule: 'max(active agents ×10 + open tasks ×3 + distinct task statuses ×5), sampled every 350ms',
+    peakAt: new Date(peak.at).toISOString(),
+    decisionPolicy: 'autonomous operator answered the scenario decision with its own default option (sim.ts law) after 900ms',
+    demoNotice: 'all data synthetic and labeled — no internal fleet info (the office demo law)',
+  },
+  status: {
+    backend: finalSnap.status.backend,
+    llmProvider: finalSnap.status.llmProvider,
+    message: finalSnap.status.message,
+    opsDone: finalSnap.status.opsDone,
+  },
+  scenario: {
+    goal: office.goal?.text ?? GOAL_TEXT,
+    goalStatus: office.goal?.status ?? null,
+    progress: office.goal?.progress ?? null,
+    tasksCreated: finalSnap.tasks.length,
+    reportsPublished: finalSnap.reports.length,
+    decisionsAsked: decisionsSeen.length,
+    decisionsResolved: finalSnap.decisions.filter((d) => d.status === 'answered').length,
+    feedItems: finalSnap.feed.length,
+  },
+  crew,
+  taskWall: wallCounts(finalSnap),
+  taskWallPeak: wallCounts(peak.snap),
+  tasks,
+  podium,
+  library,
+  books,
+  feed,
+};
+
+// ============================================================================
+// 4) status/office.html — self-contained RTL dark page, zero JS, zero assets
+// ============================================================================
+const heDate = (iso) => new Date(iso).toISOString().replace('T', ' ').replace(/\.\d+Z$/, ' UTC');
+const stateBadge = (state, heLabel) => `<span class="badge" style="color:${SEM[STATE_SEMANTIC[state] ?? 'neutral']};border-color:${SEM[STATE_SEMANTIC[state] ?? 'neutral']}55;background:${SEM[STATE_SEMANTIC[state] ?? 'neutral']}14">${esc(heLabel)}</span>`;
+
+const crewCards = crew.map((c) => `
+  <div class="desk" style="border-top:3px solid ${esc(c.color)}">
+    <div class="desk-head"><span class="dot" style="background:${esc(c.color)}"></span>
+      <b>${esc(c.name.he)}</b> <span class="en">${esc(c.name.en)}</span></div>
+    <div class="desk-title">${esc(c.title.he)} · <span class="en">${esc(c.title.en)}</span></div>
+    <div class="desk-state">${stateBadge(c.status, c.statusHe)} <span class="st">${esc(c.stationHe)}</span></div>
+    ${c.activity ? `<div class="desk-act">“${esc(c.activity)}”</div>` : ''}
+  </div>`).join('\n');
+
+const wallCols = [
+  ['planned', 'מתוכנן', 'Planned', 'todo'],
+  ['inWork', 'בעבודה', 'In work', 'doing'],
+  ['inReview', 'לביקורת', 'In review', 'review'],
+  ['done', 'הושלם', 'Done', 'done'],
+].map(([key, he, en, status]) => {
+  const cards = tasks.filter((t) => t.status === status).map((t) => `
+      <div class="tcard">
+        <div class="tt">${esc(t.title)}</div>
+        <div class="ta">${t.assigneeName ? esc(t.assigneeName.he) : (t.assignee ? esc(t.assignee) : 'לא שובץ')}<span class="en"> · ${esc(t.assignee ?? 'unassigned')}</span></div>
+        ${t.summary ? `<div class="ts">${esc(t.summary)}</div>` : ''}
+      </div>`).join('\n');
+  const extra = (status === 'done' && officeJson.taskWall.blocked + officeJson.taskWall.cancelled > 0)
+    ? `<div class="col-extra">חסומות: ${officeJson.taskWall.blocked} · בוטלות: ${officeJson.taskWall.cancelled}</div>` : '';
+  return `
+    <div class="wcol">
+      <div class="wcol-head" style="color:${SEM[TASK_SEMANTIC[status]]}">${esc(he)} <span class="en">${esc(en)}</span><span class="cnt">${officeJson.taskWall[key]}</span></div>
+      ${cards || '<div class="wcol-empty">—</div>'}${extra}
+    </div>`;
+}).join('\n');
+
+const podiumCards = podium.map((d) => `
