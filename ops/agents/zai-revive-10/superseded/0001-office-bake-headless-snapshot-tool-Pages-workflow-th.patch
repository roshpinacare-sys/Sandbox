+name: office-snapshot
+
+# ============================================================================
+# FleetHQ office bake — the public face of מפקדת הצי.
+# ----------------------------------------------------------------------------
+# The office (mini-services/agent-hq) is the live operations room of the
+# sovereignty. This workflow bakes a headless snapshot of it with the office's
+# OWN engine (tools/office-snapshot.mjs imports Office from
+# mini-services/agent-hq/src/office.ts and runs its scripted sim scenario over
+# demo-data/) and publishes the result to GitHub Pages:
+#
+#     https://roshpinacare-sys.github.io/FleetHQ/status/office.html
+#
+# GitHub minutes law: this is a PUBLIC repo — Actions minutes are free, so the
+# scheduled bake is legal and costs nothing.
+# Honesty law: the bake is REAL work (it runs the real engine); every value in
+# the artifacts is measured from the run — nothing invented, failures exit 1.
+# ============================================================================
+
+on:
+  workflow_dispatch:
+  schedule:
+    # every 3 hours at :17 — the office's public window refreshes around the clock
+    - cron: '17 */3 * * *'
+  push:
+    branches: [main]
+    paths:
+      - 'tools/office-snapshot.mjs'
+      - 'mini-services/agent-hq/**'
+      - 'src/components/agent-hq/**'
+      - 'src/components/hq/**'
+      - '.github/workflows/office-snapshot.yml'
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+concurrency:
+  group: office-snapshot-pages
+  cancel-in-progress: false
+
+jobs:
+  bake:
+    name: bake & publish office snapshot
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Bun
+        uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: latest
+
+      - name: Install dependencies
+        run: bun install --frozen-lockfile
+
+      - name: Bake office snapshot (real engine, sim mode, zero LLM keys)
+        run: bun tools/office-snapshot.mjs
+
+      # The artifact must keep the status/ path segment so the page lives at
+      # /FleetHQ/status/office.html (upload-pages-artifact treats `path` as the
+      # site root — so we stage status/ under _pages/status/ and add a tiny
+      # zero-JS redirect at the site root).
+      - name: Stage Pages artifact
+        run: |
+          set -e
+          mkdir -p _pages/status
+          cp status/office.json status/office.html _pages/status/
+          cat > _pages/index.html <<'HTML'
+          <!doctype html>
+          <html lang="he" dir="rtl">
+          <head>
+          <meta charset="utf-8">
+          <meta http-equiv="refresh" content="0; url=./status/office.html">
+          <title>מפקדת הצי — מפנה לתמונת המצב · FleetHQ</title>
+          </head>
+          <body>
+          <p><a href="./status/office.html">לתמונת המצב של המשרד · to the office snapshot</a></p>
+          </body>
+          </html>
+          HTML
+
+      - name: Upload Pages artifact
+        uses: actions/upload-pages-artifact@v3
+        with:
+          path: _pages
+
+      - name: Deploy to GitHub Pages
+        uses: actions/deploy-pages@v4
