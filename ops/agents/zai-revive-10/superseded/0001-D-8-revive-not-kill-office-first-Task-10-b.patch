+/* ═══════════ D-8 office-first · המשרד + שימושים חיים (Task 10-b) ═══════════
+ * חוק הכנות: כל טריות נקראת משדה הזמן של הפיד המחויב עצמו; פיד חסר =
+ * מצב כנה מוצהר, לעולם לא מספר מומצא. פיד המשרד הוא same-origin
+ * (/FleetHQ/status/office.json) — ואם הוא עוד לא נאפה ב-CI, הכרטיס
+ * נשאר פתוח עם קישור ומצב "ממתין לאפייה ראשונה", בלי שום המצאה. */
+const OFFICE = { fed:null, fedFail:false };
+const ALIVE = {};
+const ALIVE_FEEDS = [
+  { key:"grid",  feed:"agents/grid-truth.json",  ts:"generatedAt", page:"agents/grid-truth.json" },
+  { key:"market",feed:"agents/market-grid.json", ts:"at",          page:"agents/market-grid.json" },
+  { key:"twin",  feed:"twin-audit/latest.json",  ts:"at",          page:"twin-audit/latest.json" },
+  { key:"truth", feed:"truth/latest.json",       ts:"at",          page:"truth.html" },
+  { key:"wallet",feed:"dex/world.json",          ts:"publishedAt", page:"wallet.html" },
+  { key:"fleet", feed:"agents/registry.json",    ts:"generatedAt", page:"#/agents/fleet" }
+];
+function pickAt(j, ts){ return (j && (j[ts] || j.at || j.generatedAt || j.publishedAt || j.updatedAt)) || null; }
+function gradeOf(iso){
+  const ms = Date.now() - Date.parse(iso);
+  if(!isFinite(ms)) return { cls:"dormant", key:"st.dead" };
+  const h = ms/36e5;
+  return h<=36 ? { cls:"live", key:"st.fresh" } : (h<=168 ? { cls:"aging", key:"st.stale" } : { cls:"dormant", key:"st.dead" });
+}
+async function loadOffice(){
+  try{ OFFICE.fed = await jget("/FleetHQ/status/office.json"); OFFICE.fedFail = false; }
+  catch{ OFFICE.fed = null; OFFICE.fedFail = true; }
+}
+async function loadAlive(){
+  await Promise.all(ALIVE_FEEDS.map(f=>
+    jget(f.feed).then(j=>{ ALIVE[f.key] = { j, at: pickAt(j, f.ts) }; }).catch(()=>{ ALIVE[f.key] = null; })
+  ));
+}
+function renderOffice(){
+  const st = $("office-state"), stats = $("office-stats"), tag = $("office-demo-tag"), src = $("office-src");
+  if(!st) return;
+  const f = OFFICE.fed;
+  if(f && typeof f === "object"){
+    /* רינדור סובלני: רק שדות שנמצאו בפועל בפיד. אפס מספרים מומצאים. */
+    const num = (v)=> (typeof v === "number") ? v : (Array.isArray(v) ? v.length : null);
+    const crew = num(f.crew) ?? num(f.crewMembers) ?? num(f.crewCount);
+    const tasks = num(f.tasks) ?? num(f.taskWall) ?? num(f.openTasks);
+    const shifts = num(f.shifts) ?? num(f.shiftCount);
+    const at = pickAt(f, "generatedAt");
+    const cells = [];
+    if(crew != null) cells.push([fmtInt(crew), t("off.crew")]);
+    if(tasks != null) cells.push([fmtInt(tasks), t("off.tasks")]);
